{{ 'nw-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'nw-steps.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_background = 'transparent'
  assign show_media = false

  case section.settings.background_type
    when 'image'
      assign section_background = section.settings.background_color
      assign show_media = true
    when 'solid'
      assign section_background = section.settings.background_color
    when 'linear_gradient'
      assign section_background = section.settings.background_gradient
    when 'none'
      assign section_background = 'transparent'
  endcase

  if settings.animations_reveal_on_scroll
    assign anim_slide = 'scroll-trigger animate--slide-in'
    assign anim_fade  = 'scroll-trigger animate--fade-in'
  else
    assign anim_slide = ''
    assign anim_fade  = ''
  endif
-%}


{%  style  %} 
#shopify-section-{{section.id}} .nw-steps-wrapper{
    background: {{section_background}};
    padding-top: {{section.settings.padding_top_desktop}}px;
    padding-bottom: {{section.settings.padding_bottom_desktop}}px;
}

 #shopify-section-{{ section.id }} .nw-steps-wrapper .section-title{
      color: {{ section.settings.heading_color }};
      font-size: {{ section.settings.heading_size }}px;
    }


     @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .nw-steps-wrapper {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      #shopify-section-{{ section.id }} .nw-steps-wrapper .section-title {
        font-size: {{ section.settings.heading_size_mobile }}px;
      }
    }

{% endstyle %} 



<div class="nw-steps-wrapper">
     {%- if show_media -%}
    {%- liquid
      assign bg_image = section.settings.image
      assign bg_image_mobile = section.settings.mobile_image | default: bg_image
    -%}
    {%- if bg_image != blank -%}
      <div class="nw-steps-bg-media">
        <picture>
          {%- if bg_image_mobile != blank and bg_image_mobile != bg_image -%}
            <source media="(max-width: 749px)" srcset="{{ bg_image_mobile | image_url: width: 1200 }}">
          {%- endif -%}
          {{
            bg_image
            | image_url: width: 2500
            | image_tag: class: 'nw-step-bg-img', loading: 'lazy', alt: bg_image.alt
            | default: ''
            | escape
          }}
        </picture>
      </div>
    {%- endif -%}
  {%- endif -%}

<div class="page-width {{ anim_fade }}">
    {%-  render 'nw-section-heading', heading: section.settings.section_heading -%} 

    <div class="how-inner" {% if settings.animations_reveal_on_scroll %}data-cascade{% endif %}>
      {% for block in section.blocks %}
        {% render 'nw-steps-block', block: block, index: forloop.index, anim_slide: anim_slide %}
      {% endfor %}
    </div>

</div>


</div>



{% schema %}
{
  "name": "NW Steps",
   "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "section_heading",
      "default": "Heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "unit": "px",
      "default": 40,
      "label": "Heading font size (Desktop)",
      "min": 20,
      "max": 50,
      "step": 2
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "unit": "px",
      "default": 22,
      "label": "Heading font size (Mobile)",
      "min": 20,
      "max": 30,
      "step": 2
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0C187E"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "default": "solid",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "solid",
          "label": "Solid color"
        },
        {
          "value": "linear_gradient",
          "label": "Linear gradient"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#C3EEFF",
      "visible_if": "{{ section.settings.background_type == 'image' or section.settings.background_type == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(180deg, rgba(235, 233, 226, 1), rgba(255, 255, 255, 1) 100%)",
      "visible_if": "{{ section.settings.background_type == 'linear_gradient' }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding desktop",
      "min": 0,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding desktop",
      "min": 0,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding mobile",
      "min": 30,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding mobile",
      "min": 30,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
        "type": "nw-steps-block",
        "name": "Step",
        "settings": [
            {
                "type": "header",
                "content": "Step Content"
            },
            {
                "type": "text",
                "id": "step_title",
                "label": "Add Step Title"
            }
        ]
    }

  ],
  "class": "nw-steps-section how-it-work",
  "tag": "section",
  "presets": [
    {
      "name": "NW Steps",
      "blocks": [
        {
            "type": "nw-steps-block"
        },
        {
            "type": "nw-steps-block"
        },
        {
            "type": "nw-steps-block"
        }
      ]
    }
  ]
}
{% endschema %}
